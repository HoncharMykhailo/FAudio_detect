import tkinter as tk
from tkinter import ttk, filedialog, messagebox
import pygame
import librosa
import librosa.display
import numpy as np
import scipy.fftpack
import matplotlib
import threading
import time
from pathlib import Path
import os
import gc

from tensorflow.keras.models import load_model
from tensorflow.keras import backend as K

matplotlib.use("TkAgg")
from matplotlib.figure import Figure
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg

os.environ['TF_CPP_MIN_LOG_LEVEL'] = '3'

dur = 1


# --- ДОПОМІЖНА ФУНКЦІЯ LFCC ---
def extract_lfcc(y, sr, n_mfcc=40, n_filters=128):
    S = np.abs(librosa.stft(y, n_fft=1024, hop_length=512)) ** 2
    fft_freqs = librosa.fft_frequencies(sr=sr, n_fft=1024)
    filter_freqs = np.linspace(0, sr / 2, n_filters + 2)

    lin_filters = np.zeros((n_filters, len(fft_freqs)))
    for i in range(n_filters):
        lower, center, upper = filter_freqs[i], filter_freqs[i + 1], filter_freqs[i + 2]
        for j, f in enumerate(fft_freqs):
            if lower <= f <= center:
                lin_filters[i, j] = (f - lower) / (center - lower)
            elif center < f <= upper:
                lin_filters[i, j] = (upper - f) / (upper - center)

    linear_spec = np.dot(lin_filters, S)
    log_linear_spec = librosa.power_to_db(linear_spec)
    return scipy.fftpack.dct(log_linear_spec, axis=0, type=2, norm='ortho')[:n_mfcc]


class AudioAnalyzerApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Multispectral Audio Judge")
        self.root.geometry("1400x900")

        pygame.mixer.init(frequency=44100)

        # -------- ДАНІ ПРО МОДЕЛІ --------
        self.models = {}
        self.model_filenames = {
            'mel': "deepfake_cnn.keras",
            'lfcc': "deepfake_lfcc_cnn.keras",
            'wave': "deepfake_wave_1d.keras",
            'spec': "deepfake_spec_2d.keras",
            'fft': "deepfake_fft_1d.keras",
            'judge': "deepfake_judge.keras"
        }

        # -------- ДАНІ АУДІО --------
        self.audio_path = None
        self.audio_data = None
        self.sample_rate = None
        self.duration = 0
        self.segments = []
        self.selected_segment = None

        # -------- ПЛЕЄР --------
        self.is_playing = False
        self.start_time = 0.0
        self.paused_at = 0.0
        self.current_time = 0.0

        self.create_widgets()
        self.update_ui_loop()

    def get_model_folders(self):
        """Сканує папку training і повертає список підпапок"""
        base_dir = "training"
        if not os.path.exists(base_dir):
            os.makedirs(base_dir)
            return []

        folders = [f.name for f in os.scandir(base_dir) if f.is_dir()]
        return sorted(folders)

    def load_models_from_folder(self, folder_name):
        """Завантажує моделі з обраної папки, очищуючи попередні"""
        print(f"\n⏳ Завантаження моделей з папки: {folder_name}...")

        # Очищуємо пам'ять від старих моделей
        self.models.clear()
        K.clear_session()
        gc.collect()

        base_path = os.path.join("training", folder_name)

        for name, filename in self.model_filenames.items():
            path = os.path.join(base_path, filename)
            if os.path.exists(path):
                try:
                    self.models[name] = load_model(path)
                    print(f"✅ {name.upper()}-модель завантажено.")
                except Exception as e:
                    print(f"❌ Помилка завантаження {name}: {e}")
            else:
                print(f"⚠️ Модель {path} не знайдена.")

        # Оновлюємо статус у UI
        loaded_count = len(self.models)
        if loaded_count == 6:
            status_text = f"🟢 ШІ активний ({folder_name} | Завантажено: 6/6)"
            color = "green"
        elif loaded_count > 0:
            status_text = f"🟠 ШІ частково активний ({folder_name} | Завантажено: {loaded_count}/6)"
            color = "orange"
        else:
            status_text = f"🔴 Моделі в папці '{folder_name}' не знайдені!"
            color = "red"

        if hasattr(self, 'status_label'):
            self.status_label.config(text=status_text, fg=color)

    def on_folder_change(self, event):
        """Обробник зміни папки у випадаючому списку"""
        selected_folder = self.model_var.get()
        if selected_folder:
            self.load_models_from_folder(selected_folder)

            if self.audio_path:
                print("🔄 Перерахунок результатів новими моделями...")
                for item in self.tree.get_children():
                    self.tree.delete(item)
                threading.Thread(target=self.analyze_audio, daemon=True).start()

    # =====================================================
    # UI SETUP
    # =====================================================
    def create_widgets(self):
        main = tk.Frame(self.root)
        main.pack(fill="both", expand=True)

        self.upload_frame = tk.Frame(main)
        self.upload_frame.pack(fill="x", pady=20)

        model_selection_frame = tk.Frame(self.upload_frame)
        model_selection_frame.pack(pady=(0, 15))

        tk.Label(model_selection_frame, text="Виберіть набір моделей (датасет):", font=("Arial", 11)).pack(pady=(0, 5))

        self.folders = self.get_model_folders()
        self.model_var = tk.StringVar()
        self.folder_cb = ttk.Combobox(model_selection_frame, textvariable=self.model_var, values=self.folders,
                                      state="readonly", width=40)
        self.folder_cb.pack()
        self.folder_cb.bind("<<ComboboxSelected>>", self.on_folder_change)

        self.status_label = tk.Label(model_selection_frame, text="", font=("Arial", 10, "bold"))
        self.status_label.pack(pady=5)

        if self.folders:
            self.folder_cb.current(0)
            self.load_models_from_folder(self.folders[0])
        else:
            self.status_label.config(text="🔴 Папка 'training' порожня або відсутня!", fg="red")

        tk.Button(self.upload_frame, text="Вибрати аудіофайл", command=self.load_file, bg="#667eea", fg="white",
                  font=("Arial", 12)).pack()

        self.player_frame = tk.Frame(main)
        self.file_label = tk.Label(self.player_frame, font=("Arial", 12, "bold"))
        self.file_label.pack(pady=5)

        controls = tk.Frame(self.player_frame)
        controls.pack()
        self.play_btn = tk.Button(controls, text="▶ Play", command=self.toggle_play, width=10)
        self.play_btn.pack(side="left", padx=5)
        tk.Button(controls, text="⏹ Stop", command=self.stop_audio, width=10).pack(side="left", padx=5)

        tk.Button(controls, text="📂 Новий файл", command=self.reset_app, width=12).pack(side="left", padx=5)

        self.time_label = tk.Label(controls, text="00:00 / 00:00")
        self.time_label.pack(side="left", padx=15)

        self.progress_bar = ttk.Scale(self.player_frame, from_=0, to=1, orient="horizontal")
        self.progress_bar.pack(fill="x", padx=20, pady=10)
        self.progress_bar.bind("<ButtonPress-1>", lambda e: setattr(self, 'is_dragging', True))
        self.progress_bar.bind("<ButtonRelease-1>", self.on_slider_release)
        self.is_dragging = False

        self.content_frame = tk.Frame(main)

        left_panel = tk.Frame(self.content_frame, width=500)
        left_panel.pack(side="left", fill="y", padx=10, pady=10)
        left_panel.pack_propagate(False)

        cols = ("id", "time", "mel", "lfcc", "wave", "spec", "fft", "judge")
        self.tree = ttk.Treeview(left_panel, columns=cols, show="headings")
        self.tree.heading("id", text="#")
        self.tree.heading("time", text="Час")
        self.tree.heading("mel", text="Mel")
        self.tree.heading("lfcc", text="LFCC")
        self.tree.heading("wave", text="Wave")
        self.tree.heading("spec", text="Spec")
        self.tree.heading("fft", text="FFT")
        self.tree.heading("judge", text="⚖️ ВИРОК")

        self.tree.column("id", width=30, anchor="center")
        self.tree.column("time", width=80, anchor="center")
        for col in ["mel", "lfcc", "wave", "spec", "fft"]:
            self.tree.column(col, width=60, anchor="center")
        self.tree.column("judge", width=90, anchor="center")

        # Кольорові теги для таблиці
        self.tree.tag_configure("real", background="#c8e6c9")
        self.tree.tag_configure("fake", background="#ffcdd2")
        self.tree.tag_configure("suspicious", background="#fff9c4")
        self.tree.tag_configure("silence", background="#e0e0e0")

        self.tree.pack(side="left", fill="both", expand=True)
        self.tree.bind("<<TreeviewSelect>>", self.on_segment_select)

        # --- ГРАФІКИ ---
        self.plot_container = tk.Frame(self.content_frame)
        self.plot_container.pack(side="right", fill="both", expand=True, padx=10, pady=10)

        self.canvas_scroll = tk.Canvas(self.plot_container, highlightthickness=0)
        self.scrollbar = ttk.Scrollbar(self.plot_container, orient="vertical", command=self.canvas_scroll.yview)
        self.scrollable_frame = tk.Frame(self.canvas_scroll)

        self.scrollable_frame.bind("<Configure>",
                                   lambda e: self.canvas_scroll.configure(scrollregion=self.canvas_scroll.bbox("all")))
        self.canvas_window = self.canvas_scroll.create_window((0, 0), window=self.scrollable_frame, anchor="nw")
        self.canvas_scroll.bind("<Configure>",
                                lambda e: self.canvas_scroll.itemconfig(self.canvas_window, width=e.width))
        self.canvas_scroll.configure(yscrollcommand=self.scrollbar.set)

        self.canvas_scroll.pack(side="left", fill="both", expand=True)
        self.scrollbar.pack(side="right", fill="y")
        self.canvas_scroll.bind_all("<MouseWheel>", self._on_mousewheel)

        self.fig = Figure(figsize=(8, 16), dpi=100)
        self.ax_wave = self.fig.add_subplot(5, 1, 1)
        self.ax_spec = self.fig.add_subplot(5, 1, 2, sharex=self.ax_wave)
        self.ax_fft = self.fig.add_subplot(5, 1, 3)
        self.ax_mfcc = self.fig.add_subplot(5, 1, 4, sharex=self.ax_wave)
        self.ax_lfcc = self.fig.add_subplot(5, 1, 5, sharex=self.ax_wave)
        self.fig.tight_layout(pad=4.0)

        self.playheads = {}
        self.mpl_canvas = FigureCanvasTkAgg(self.fig, master=self.scrollable_frame)
        self.mpl_canvas.get_tk_widget().pack(fill="both", expand=True)

    def _on_mousewheel(self, event):
        self.canvas_scroll.yview_scroll(int(-1 * (event.delta / 120)), "units")

    # =====================================================
    # LOGIC: PREDICTION & ANALYSIS
    # =====================================================
    def predict_ai_ensemble(self, chunk, original_sr):
        preds = {k: None for k in self.model_filenames.keys()}

        chunk_22k = librosa.resample(y=chunk, orig_sr=original_sr, target_sr=22050) if original_sr != 22050 else chunk
        target_len = int(22050 * dur)

        if len(chunk_22k) > target_len:
            chunk_22k = chunk_22k[:target_len]
        else:
            chunk_22k = np.pad(chunk_22k, (0, max(0, target_len - len(chunk_22k))), "constant")

        wave = librosa.resample(chunk_22k, orig_sr=22050, target_sr=8000)
        spec = librosa.power_to_db(np.abs(librosa.stft(chunk_22k, n_fft=1024, hop_length=512)), ref=np.max)
        fft = np.abs(np.fft.rfft(chunk_22k))
        mel = librosa.power_to_db(librosa.feature.melspectrogram(y=chunk_22k, sr=22050, n_mels=128, fmax=8000),
                                  ref=np.max)
        lfcc = extract_lfcc(chunk_22k, 22050)

        features = {'wave': wave, 'spec': spec, 'fft': fft, 'mel': mel, 'lfcc': lfcc}

        # 1. Отримання базових прогнозів
        for name, feat in features.items():
            if name in self.models:
                input_data = feat[np.newaxis, ..., np.newaxis]
                preds[name] = float(self.models[name].predict(input_data, verbose=0)[0][0])

        # 2. Передача базових прогнозів Судді (Judge)
        if 'judge' in self.models and all(preds[k] is not None for k in ['mel', 'lfcc', 'wave', 'spec', 'fft']):
            judge_input = np.array([[preds['mel'], preds['lfcc'], preds['wave'], preds['spec'], preds['fft']]])
            preds['judge'] = float(self.models['judge'].predict(judge_input, verbose=0)[0][0])

        return preds

    def analyze_audio(self):
        y, sr = librosa.load(self.audio_path, sr=None)
        self.audio_data, self.sample_rate, self.duration = y, sr, len(y) / sr
        self.root.after(0, lambda: self.progress_bar.config(to=self.duration))

        step = int(dur * sr)
        self.segments.clear()

        for i in range(0, len(y), step):
            chunk = y[i:i + step]
            if len(chunk) < step // 2: continue

            rms = float(np.sqrt(np.mean(chunk ** 2)))

            if rms >= 0.005:
                scores = self.predict_ai_ensemble(chunk, sr)
            else:
                scores = {k: None for k in self.model_filenames.keys()}

            self.segments.append({
                "id": len(self.segments) + 1, "start": i / sr, "end": (i + step) / sr,
                "data": chunk, "sr": sr, "scores": scores
            })

        self.root.after(0, self.populate_table)

    def populate_table(self):
        for item in self.tree.get_children():
            self.tree.delete(item)

        for seg in self.segments:
            s = seg["scores"]

            if all(v is None for v in s.values()):
                texts = ["Тиша"] * 6
                tag = "silence"
            else:
                texts = []
                for k in ["mel", "lfcc", "wave", "spec", "fft", "judge"]:
                    if s.get(k) is not None:
                        texts.append(f"{s[k] * 100:.0f}%")
                    else:
                        texts.append("-")

                judge_score = s.get("judge")
                if judge_score is not None:
                    if judge_score > 0.65:
                        tag = "fake"
                    elif judge_score < 0.35:
                        tag = "real"
                    else:
                        tag = "suspicious"
                else:
                    tag = "silence"

            self.tree.insert("", "end", values=(seg["id"], f"{seg['start']:.1f}-{seg['end']:.1f}", *texts), tags=(tag,))

    def load_file(self):
        path = filedialog.askopenfilename(filetypes=[("Audio", "*.wav *.mp3 *.flac")])
        if not path: return
        self.audio_path = path
        self.file_label.config(text=f"Файл: {Path(path).name}")
        self.upload_frame.pack_forget()
        self.player_frame.pack(fill="x", pady=10)
        self.content_frame.pack(fill="both", expand=True)
        pygame.mixer.music.load(path)
        threading.Thread(target=self.analyze_audio, daemon=True).start()

    def on_segment_select(self, event):
        sel = self.tree.selection()
        if not sel: return
        seg_id = int(self.tree.item(sel[0])["values"][0])
        self.selected_segment = next((s for s in self.segments if s["id"] == seg_id), None)
        if self.selected_segment: self.plot_segment()

    def plot_segment(self):
        seg, raw_data, original_sr = self.selected_segment, self.selected_segment["data"], self.selected_segment["sr"]

        chunk_22k = librosa.resample(y=raw_data, orig_sr=original_sr,
                                     target_sr=22050) if original_sr != 22050 else raw_data
        target_len = int(22050 * dur)

        if len(chunk_22k) > target_len:
            chunk_22k = chunk_22k[:target_len]
        else:
            chunk_22k = np.pad(chunk_22k, (0, max(0, target_len - len(chunk_22k))), "constant")

        wave_ai = librosa.resample(chunk_22k, orig_sr=22050, target_sr=8000)
        spec_ai = librosa.power_to_db(np.abs(librosa.stft(chunk_22k, n_fft=1024, hop_length=512)), ref=np.max)
        fft_ai = np.abs(np.fft.rfft(chunk_22k))
        mel_ai = librosa.power_to_db(librosa.feature.melspectrogram(y=chunk_22k, sr=22050, n_mels=128, fmax=8000),
                                     ref=np.max)
        lfcc_ai = extract_lfcc(chunk_22k, 22050)

        for ax in [self.ax_wave, self.ax_spec, self.ax_fft, self.ax_mfcc, self.ax_lfcc]:
            ax.clear()

        t_wave = np.linspace(0, dur, len(wave_ai))
        self.ax_wave.plot(t_wave, wave_ai, color="#4F46E5", lw=0.8)
        self.ax_wave.set_title(f"Форма хвилі (як бачить Wave-модель: 8000 Hz, {len(wave_ai)} значень)", fontsize=10)
        self.ax_wave.set_xlim(0, dur)

        librosa.display.specshow(spec_ai, sr=22050, hop_length=512, x_axis="time", y_axis="linear", ax=self.ax_spec,
                                 cmap='magma')
        self.ax_spec.set_title(f"Лінійна Спектрограма (Матриця: {spec_ai.shape[0]}x{spec_ai.shape[1]})", fontsize=10)

        freq_ai = np.fft.rfftfreq(len(chunk_22k), 1 / 22050)
        self.ax_fft.plot(freq_ai, fft_ai, color="#059669")
        self.ax_fft.set_title(f"FFT Спектр (Масив: {len(fft_ai)} значень)", fontsize=10)
        self.ax_fft.set_xlim(0, 8000)

        librosa.display.specshow(mel_ai, sr=22050, hop_length=512, x_axis="time", y_axis="mel", fmax=8000,
                                 ax=self.ax_mfcc, cmap='coolwarm')
        self.ax_mfcc.set_title(f"Мел-спектрограма (Матриця: {mel_ai.shape[0]}x{mel_ai.shape[1]})", fontsize=10)

        librosa.display.specshow(lfcc_ai, sr=22050, hop_length=512, x_axis="time", ax=self.ax_lfcc, cmap='viridis')
        self.ax_lfcc.set_title(f"LFCC (Матриця: {lfcc_ai.shape[0]}x{lfcc_ai.shape[1]})", fontsize=10)

        self.playheads = {
            'wave': self.ax_wave.axvline(x=0, color='red', lw=1.5),
            'spec': self.ax_spec.axvline(x=0, color='red', lw=1.5),
            'mfcc': self.ax_mfcc.axvline(x=0, color='red', lw=1.5),
            'lfcc': self.ax_lfcc.axvline(x=0, color='red', lw=1.5)
        }
        self.fig.tight_layout(pad=3.0)
        self.mpl_canvas.draw()

    def toggle_play(self):
        if self.is_playing:
            pygame.mixer.music.pause()
            self.paused_at += time.time() - self.start_time
            self.is_playing = False
            self.play_btn.config(text="▶ Play")
        else:
            if self.paused_at == 0:
                pygame.mixer.music.play()
            else:
                pygame.mixer.music.unpause()
            self.start_time, self.is_playing = time.time(), True
            self.play_btn.config(text="⏸ Pause")

    def stop_audio(self):
        pygame.mixer.music.stop()
        self.is_playing, self.paused_at, self.current_time = False, 0, 0
        self.play_btn.config(text="▶ Play")
        self.progress_bar.set(0)
        for ph in self.playheads.values(): ph.set_xdata([-1, -1])
        self.mpl_canvas.draw_idle()

    def reset_app(self):
        self.stop_audio()
        self.segments.clear()
        self.selected_segment = None
        self.audio_path = None

        for item in self.tree.get_children():
            self.tree.delete(item)

        for ax in [self.ax_wave, self.ax_spec, self.ax_fft, self.ax_mfcc, self.ax_lfcc]:
            ax.clear()
        self.mpl_canvas.draw()

        self.player_frame.pack_forget()
        self.content_frame.pack_forget()

        self.folders = self.get_model_folders()
        self.folder_cb['values'] = self.folders

        self.upload_frame.pack(fill="x", pady=20)

    def on_slider_release(self, event):
        self.is_dragging = False
        self.paused_at = self.progress_bar.get()
        if self.is_playing:
            pygame.mixer.music.play(start=self.paused_at)
            self.start_time = time.time()

    def update_ui_loop(self):
        if self.is_playing:
            self.current_time = self.paused_at + (time.time() - self.start_time)
            if self.current_time >= self.duration:
                self.stop_audio()
            else:
                if not self.is_dragging: self.progress_bar.set(self.current_time)
                self.time_label.config(
                    text=f"{int(self.current_time // 60):02d}:{int(self.current_time % 60):02d} / {int(self.duration // 60):02d}:{int(self.duration % 60):02d}")
                if self.selected_segment:
                    local_time = self.current_time - self.selected_segment["start"]
                    if 0 <= local_time <= (self.selected_segment["end"] - self.selected_segment["start"]):
                        for ph in self.playheads.values(): ph.set_xdata([local_time, local_time])
                        self.mpl_canvas.draw_idle()
        self.root.after(50, self.update_ui_loop)


if __name__ == "__main__":
    root = tk.Tk()
    style = ttk.Style()
    style.theme_use('clam')
    app = AudioAnalyzerApp(root)
    root.mainloop()
